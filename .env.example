# Copy to .env before the first run: `cp .env.example .env`
#
#   cp .env.example .env && docker-compose up -d
#
# Credentials live here only - docker-compose.yml carries no password defaults,
# so it refuses to start until POSTGRES_PASSWORD is set. .env is gitignored;
# .env.example (this file) is committed and must never hold a real secret.
# In production these values come from Vault / Key Vault (design doc section 11).

# --- Host port mappings (change if these are taken on your machine) ---
API_HOST_PORT=8080
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# --- Database ---
# REQUIRED. Local-only placeholder - replace it for anything but a laptop POC.
# The value is interpolated into a postgresql:// URL, so percent-encode any of
# : / ? # [ ] @ rather than using them literally.
# Changing it after the first run needs `docker-compose down -v`: Postgres only
# applies POSTGRES_PASSWORD when it initialises an empty data volume.
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_USER=hdai
POSTGRES_DB=hdai

# --- LLM (OPTIONAL) ---
# Leave empty to run the deterministic rule-based pipeline only.
# With a key set, the 5 agents use Claude and fall back to rules on any failure.
ANTHROPIC_API_KEY=
HDAI_LLM_MODEL=claude-haiku-4-5-20251001
# auto = use the LLM only if a key is present. on = require it. off = never.
HDAI_LLM_ENABLED=auto

# --- Behaviour ---
HDAI_LOG_LEVEL=INFO
# Sample data has 2026-08 slots (in the past). true shifts them forward so the
# POC has bookable availability. Set false for production data.
HDAI_DEMO_SHIFT_PAST_SLOTS=true
